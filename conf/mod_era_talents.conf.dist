# mod-era-talents/conf/mod_era_talents.conf.dist
[worldserver]
# Opt in explicitly. The portable earned-progression profile enables the module.
EraTalents.Enable = 0
EraTalents.Debug = 0
# Humans and bots use their own earned IndividualProgression milestones, never level bands
# or a group leader's stage. Talent budgets come only from real earned levels (51/61 points).
# Random-bot builds spend new points incrementally; routine refreshes never reset them.
# Altbots and SelfBot characters keep unspent points for their owner.
EraTalents.BotTalents = 0
# Glyphs become usable after earning Wrath. Earlier eras block application/use but preserve
# equipped glyph rows, so an existing character's paid glyphs return in the earned Wrath era.
# Existing classes without historical trees retain their native fallback.
EraTalents.GlyphGate = 1
# Compatibility key only: force-advance gossip is disabled in the earned adaptation.
# The ordinary IP boss-credit and quest paths remain the only expansion advancement paths.
EraTalents.AdvanceGossip = 0
